{
  "name": "fox-vs-fly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "prebuild": "python3 ../brain/preprocess/package_geometry.py && python3 ../brain/preprocess/package_graph.py",
    "cinematic": "vite --host 127.0.0.1 --open /cinematic/",
    "cinematic:build": "tsc --noEmit && vite build",
    "cinematic:frames": "npm run cinematic:build && node scripts/cinematic-frames.mjs",
    "cinematic:video": "node scripts/cinematic-video.mjs",
    "cinematic:export": "npm run cinematic:frames && npm run cinematic:video"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.170.0",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}
